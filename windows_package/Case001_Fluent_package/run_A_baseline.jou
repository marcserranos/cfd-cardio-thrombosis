/file/start-transcript "results_A_baseline/transcript_run.txt"
/file/read-case "inputs/LA_Case001.msh.gz"
/mesh/check
/mesh/quality
/define/models/unsteady-1st-order? yes
/define/models/viscous/laminar? yes
/define/materials/change-create air blood yes constant 1060 no no yes constant 0.0035 no no no yes
/define/boundary-conditions/set/fluid fluid () material yes blood quit
/file/read-transient-table "inputs/velocity_outlet.prof"
/file/read-transient-table "inputs/pressure_inlet.prof"
/file/read-transient-table "inputs/motion.prof"
/define/boundary-conditions/set/velocity-inlet mv () vmag yes no "velocity_bc_c" "u" quit
/define/boundary-conditions/set/pressure-inlet pv_rs pv_ri pv_ls pv_li () p0 yes no "function_pressure_c" "pressure" quit
/define/dynamic-mesh/dynamic-mesh? yes no no no no
/define/dynamic-mesh/controls/smoothing? yes
/define/dynamic-mesh/controls/remeshing? yes
/define/dynamic-mesh/controls/smoothing-parameters/smoothing-method diffusion
/define/dynamic-mesh/controls/smoothing-parameters/diffusion-coeff-parameter 2
/define/dynamic-mesh/controls/remeshing-parameters/length-min 0.0005
/define/dynamic-mesh/controls/remeshing-parameters/length-max 0.0016
/define/dynamic-mesh/controls/remeshing-parameters/cell-skew-max 0.9
/define/dynamic-mesh/zones/create mv rigid-body "mov_bc_c" no no 0 0 0 0 0 0 1 fluid constant 0.0013 no no
/define/dynamic-mesh/zones/create wall deforming faceted no yes yes yes no yes no yes
/define/dynamic-mesh/zones/create pv_rs stationary fluid constant 0.0013 no
/define/dynamic-mesh/zones/create pv_ri stationary fluid constant 0.0013 no
/define/dynamic-mesh/zones/create pv_ls stationary fluid constant 0.0013 no
/define/dynamic-mesh/zones/create pv_li stationary fluid constant 0.0013 no
/define/dynamic-mesh/zones/create fluid deforming yes yes yes
/define/dynamic-mesh/zones/list
/solve/set/p-v-coupling 24
/solve/set/gradient-scheme yes
/solve/set/discretization-scheme/mom 1
/solve/set/discretization-scheme/pressure 12
/solve/monitors/residual/convergence-criteria 0.005 0.001 0.001 0.001
/solve/set/transient-controls/time-step-size 0.005
/file/auto-save/data-frequency 50
/file/auto-save/root-name "results_A_baseline/LA_Case001"
/file/transient-export/ensight-gold-transient
"results_A_baseline/LA_Case001_ens"

fluid

pressure
velocity-magnitude
x-velocity
y-velocity
z-velocity
wall-shear
x-wall-shear
y-wall-shear
z-wall-shear
vorticity-mag
q-criterion
lambda2-criterion
strain-rate-mag
q
no
yes
"ensight-export"
"time-step"
2
yes
/solve/initialize/compute-defaults/all-zones
/solve/initialize/initialize-flow
/file/write-case "results_A_baseline/LA_Case001_setup.cas.h5"
/solve/dual-time-iterate 350 100
/file/write-case-data "results_A_baseline/LA_Case001_final.cas.h5"
/report/system/time-stats
/file/stop-transcript
/exit
yes
